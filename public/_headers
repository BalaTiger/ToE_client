/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sounds/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

/bg.webp
  Cache-Control: public, max-age=604800

/socket.io.min.js
  Cache-Control: public, max-age=604800

/resource-manifest.json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/*.html
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
